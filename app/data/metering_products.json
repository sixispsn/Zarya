  "sources": {
    "vt386-0625": {
      "url": "https://valtec.ru/document/technical/VT.386-0625.pdf",
      "title": "VALTEC VT.386, ПС-47335-3, паспорт и руководство по эксплуатации",
      "pages": "1: параметры; 2: раздел 4 (A — осевая длина, B — полный габарит); 2–3: п. 6.1 и рисунки монтажа",
      "checked_on": "2026-10-14",
      "sha256": "427e9a91b2a8bae33c8a4331d53e8af764774b147adda39d7dac9d0bd3a925b3",
      "note": "DN15/20/25: A=56/58/84 мм. Не переносить старую длину 53 мм из альбома 2010. Подтверждены горизонтальная установка пробкой вниз и восходящий поток; нисходящая установка в данной базе не разрешена."
    },
    "proaqua-ppr-2026": {
      "url": "https://www.proaqua.pro/upload/iblock/261/1o44s6t2cc17pvczla3aed26ygk36xug/PRO%20AQUA%20PP-R%202026.pdf",
      "title": "PRO AQUA PP-R, технический каталог 2026", "pages": "42: труба PA10018; 50: муфта PA22524P",
      "checked_on": "2026-09-30", "sha256": "fe90a661010f194d189375ccbcf6d772520e18693e353d4b238f1abac948acbc",
      "note": "PA10018: 63×10,5, внутренний диаметр 42 мм. PA22524P: 63×2 ВР, L=77 мм. Это не DN63 и не монтажная длина соединения."
    },
    "proaqua-fittings-passport": {
      "url": "https://www.proaqua.pro/upload/exchange/files/042707.pdf",
      "title": "PRO AQUA, паспорт соединительных деталей PP-R", "pages": "2: пп. 1.2–1.3; 8: PA22524P",
      "checked_on": "2026-09-30", "sha256": "a8d5ecdcc6ac1dbef171e83e16092e57915fb37e01c0d70542f2336e44d0b349",
      "note": "Внутренняя резьба цилиндрическая по ГОСТ 6357, наружная коническая по ГОСТ 6211. Буква G в общей размерной таблице не разрешает считать наружную резьбу цилиндрической."
    },
    "vtr-1025": {
      "url": "https://valtec.ru/document/technical/VTr-1025.pdf",
      "title": "VALTEC VTr, ПС 47639-4", "pages": "2: резьба, P/T; 8: VTr.580.N.0907; 9: VTr.582.N.0009",
      "checked_on": "2026-09-30", "sha256": "44e8069b8d2e0660acd4e1ca60a2e4f9b42c047db86bf31bafc22ca1a76be6f6",
      "note": "VTr.582.N.0009: G2 НР/НР, A=44 мм. VTr.580.N.0907: G2×G1¼ НР/НР, A=41 мм. Наружная резьба не предназначена для накидной гайки с плоской прокладкой."
    },
    "vtr580-drawing": {
      "url": "https://valtec.ru/document/technical/drawing/VTr.580.N/VTr.580.N.pdf",
      "title": "VALTEC VTr.580.N, габаритный чертёж", "pages": "1: VTr.580.N.0907",
      "checked_on": "2026-09-30", "sha256": "0e85fe1c895808359d59831e34bf1cb57ba326b77ae2f4282479ef65c0d25df2",
      "note": "Для .0907 резьбы G2×G1¼ и осевой габарит 41 мм совпадают с паспортом. Поперечный размер 65,5 мм отличается от S=61 мм паспорта: в базу не внесён. Проверка L не подтверждает полный внешний контур."
    },
    "vtr582-drawing": {
      "url": "https://valtec.ru/document/technical/drawing/VTr.582.N/VTr.582.N.pdf",
      "title": "VALTEC VTr.582.N, габаритный чертёж", "pages": "1: VTr.582.N.0009",
      "checked_on": "2026-09-30", "sha256": "6cb16b748d0662f19967df590570dd8707ff6e4eb97a49bb5bf4cd0e80e43e33",
      "note": "Для .0009 длина 44 мм совпадает с паспортом. Поперечные размеры и другие типоразмеры этим не подтверждены."
    },
    "itap-europa-100": {
      "url": "https://www.itap.it/cat_files/pdf/EUROPA_CHECK_AND_FOOT_VALVES_en.pdf",
      "title": "ITAP EUROPA 100, резьба ISO 228 (не NPT)",
      "pages": "3: характеристики и артикулы; 4: размеры; 6: монтаж",
      "checked_on": "2026-09-30", "sha256": "1d012d78cebbf2ae410cc6fb5832a5bfe11a9ccea27fdd8d2c30e7df374aced6",
      "note": "A — осевая длина корпуса. Не длина установленного узла. От изгиба/циркуляционного насоса паспорт требует 10 диаметров трубы."
    },
    "vtp-0626": {
      "url": "https://valtec.ru/document/technical/VTp.700-fitingi-0626.pdf",
      "title": "VALTEC, ПС 47543-6, полипропиленовые фитинги",
      "pages": "1–2: характеристики; 4: VTp.707; 10: VTp.761; 13: монтаж",
      "checked_on": "2026-09-30", "sha256": "cd94f41c6e92266c49c9d2f15255fccc96be8707b504777c8ce66a72bc1d9a10",
      "note": "A — полный осевой габарит; B — геометрическая глубина раструба, не заданная монтажная посадка. Для выбранных 63×2 габариты расходятся с отдельными чертежами."
    },
    "vtp707-drawing": {
      "url": "https://valtec.ru/document/technical/drawing/VTp.707.0/VTp.707.0.pdf",
      "title": "VALTEC VTp.707.0, габаритный чертёж", "pages": "1",
      "checked_on": "2026-09-30", "sha256": "ae2aca88b9745f9b1ddfef21f16d01a13607952ff16fd0f7e8397d466ec8de6a",
      "note": "63×2: длина 124,5 мм, в паспорте 102 мм. Карантин до уточнения исполнения."
    },
    "vtp761-drawing": {
      "url": "https://valtec.ru/document/technical/drawing/VTp.761.0/VTp.761.0.pdf",
      "title": "VALTEC VTp.761.0, габаритный чертёж", "pages": "1",
      "checked_on": "2026-09-30", "sha256": "99d62394c7a9bc22deba5e8a81cbbbaef69226cb072fce947b72d70bb5a4b3c3",
      "note": "63×2: длина 94,3 мм, в паспорте 85 мм. Карантин до уточнения исполнения."
    },
    "decast-106": {
      "url": "https://decast.com/upload/documentation/site-doc/Образцы-паспортов/Образец_паспорта_ВСКМ90.pdf",
      "title": "ДЕКАСТ ВСКМ 90. ДКСТ.407221.001ПС, ред. 1.06",
      "pages": "1: таблицы 1, 2, 7, рисунок 1; 2: таблица 6, раздел 5",
      "checked_on": "2026-09-30", "sha256": "9ecb8319ea73f0de884a73c79073d70a0bf3028452a04728141dfceb2cfc307e",
      "note": "ДГ — отдельное импульсное исполнение. Цену импульса подтвердить по конкретному прибору: таблица 2 содержит примечание о положении геркона. L1 и состав комплекта уточняются при заказе."
    },
    "walraven-1301-0425": {
      "url": "https://library.walraven.com/repository/rnd/documents/EN-INT/BIS%20Bifix%C2%AE%201301%20Stainless%20Steel%20%28M8%2C%20M10%29%20-%20M%2005%2005%20%28EN-INT%29.pdf",
      "title": "Walraven BIS Bifix 1301, M 05 05, EN-INT 04/2025",
      "pages": "1: размерный рисунок и таблица M8",
      "checked_on": "2026-09-30", "sha256": "6e588887d49c8760c934d1282c28773119e5347a8f9c4833db6cf350dc2653da",
      "note": "Для нержавеющих труб. D — наружный диаметр, не DN. Fa,z — допустимая нагрузка хомута в указанном направлении, не несущая способность всей опоры."
    },
    "decast-2023": {
      "url": "https://decast.com/upload/documentation/passport/Образец_паспорта_Декаст_ВСКМ90_2023.pdf",
      "title": "ДЕКАСТ ВСКМ 90. ДКСТ.407221.001ПС, ред. 1.03",
      "pages": "1: таблицы 1, 6; 2: раздел 5", "checked_on": "2026-09-30",
      "note": "L1 зависит от комплекта монтажных частей и уточняется при заказе. Прямые участки обеспечиваются комплектом; переходы вне этой зоны."
    },
    "vt214-1224": {
      "url": "https://valtec.ru/document/technical/VT.214-215-217-218-219-1224.pdf",
      "title": "VALTEC VT.214, ПС-47558", "pages": "2: давление/температура; 3: габариты",
      "checked_on": "2026-09-30", "sha256": "29dac853dfa10180f968db1c7339f5425f90cce0e1a51e2da8c2269f27125bc1",
      "note": "C — строительная длина; A — длина рукоятки, НЕ длина корпуса. B — от оси до верха."
    },
    "vt192-0825": {
      "url": "https://valtec.ru/document/technical/VT.190-191-192-0825.pdf",
      "title": "VALTEC VT.192, ПС-47243-2", "pages": "1: характеристики; 2–3: габариты и монтаж",
      "checked_on": "2026-09-30", "sha256": "603d2085bb2a6685d5fdf44ad29b6cecc7f1ae68baa79ebde9be69a54eee3d62",
      "note": "H — ниже оси, не полный габарит и не пространство обслуживания. Горизонтальный монтаж пробкой вниз."
    },
    "vt161-0525": {
      "url": "https://valtec.ru/document/technical/VT.161-0525.pdf",
      "title": "VALTEC VT.161, ПС-47651", "pages": "1: характеристики; 3: размеры A/B",
      "checked_on": "2026-09-30", "sha256": "d25a0468d5d65fb8427670d93a0a4f72c620030e23d947560e6f2c7edea798bc"
