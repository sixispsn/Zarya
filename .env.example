# Домен без https://, например zarya.example.ru
ZARYA_DOMAIN=zarya.example.ru

# Имя пользователя для входа на сайт
ZARYA_USERNAME=zarya

# Только bcrypt-хеш, не пароль. Одинарные кавычки сохраняют символы $ буквально.
ZARYA_PASSWORD_HASH='$2a$14$replace_with_hash_from_caddy_hash_password'

# Commit, из которого собран контейнер. Перед запуском задаётся командой
# export ZARYA_BUILD_COMMIT=$(git rev-parse HEAD)
ZARYA_BUILD_COMMIT=replace_with_git_commit

# Фоновая read-only проверка официальных карточек Росстандарта (6 часов).
ZARYA_NORMATIVE_MONITOR_ENABLED=1
ZARYA_NORMATIVE_MONITOR_INTERVAL_SECONDS=21600
